{% extends "master.twig" %}

{% block content %}
    <style>
        #categoryTabs .nav-link.active {
            color: black !important;
        }
    </style>
    <!-- ======= documentry Section ======= -->
    <section id="short-film" class="section-show">
        <ul class="nav nav-tabs justify-content-center" id="categoryTabs" role="tablist">
            {% for category in categories %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link text-white {% if loop.first %}active{% endif %}"
                            id="tab-{{ loop.index }}"
                            data-bs-toggle="tab"
                            data-bs-target="#content-{{ loop.index }}"
                            type="button"
                            role="tab"
                            aria-controls="content-{{ loop.index }}"
                            aria-selected="{% if loop.first %}true{% else %}false{% endif %}">
                        {{ category }}
                    </button>
                </li>
            {% endfor %}
        </ul>
        <div class="tab-content mt-4" id="categoryTabsContent">
            {% for category in categories %}
                <div class="tab-pane fade {% if loop.first %}show active{% endif %}"
                     id="content-{{ loop.index }}"
                     role="tabpanel"
                     aria-labelledby="tab-{{ loop.index }}">
                    {% for item in items %}
                        {% if item.category == category %}
                            <div class="resume">
                                <div class="container">
                                    <div class="section-title">
                                        <h2>{{ category }}</h2>
                                        <p>{{ item.title }}</p>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-6">
                                            <iframe width="100%" height="315"
                                                    src="{{ item.youtube }}"
                                                    title="YouTube video player"
                                                    frameborder="0"
                                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                                    allowfullscreen></iframe>
                                        </div>
                                        <div class="col-lg-6">
                                            <div class="resume-item pb-0">
                                                {{ item.description|raw }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    </section>
    <!-- End documentry Section -->
{% endblock %}