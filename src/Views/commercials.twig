{% extends "master.twig" %}

{% block content %}
	<!-- ======= Commercials Section ======= -->
	<section id="commercials" class="section-show py-5 bg-light">
		<div class="container">
			<div class="section-title text-center mb-5">
				<h2 class="display-4 fw-bold text-primary">Commercials</h2>
				<p class="lead text-muted">Social Media Content</p>
			</div>

			<!-- Video Grid -->
			<div class="row g-4">
				{% for item in items %}
					<div class="col-md-4 col-sm-6 mb-3">
						<div class="video-card" style="aspect-ratio: 16/9; object-fit: cover;">
							<video class="video-player video-js vjs-big-play-centered" controls preload="none" height="100px" width="100px" poster="{{item.poster}}">
								<source src="{{item.video}}" type="video/mp4"/>
								<p>Your browser does not support the video tag.</p>
							</video>
						</div>
					</div>
				{% endfor %}
			</div>

			<style>
                .vjs-poster>img {
                    object-fit: cover;
                    /* aspect-ratio: 16/9; */
                }
				.video-card {
					transition: transform 0.3s ease;
					height: 100%;
					position: relative;
				}

				.video-player {
					width: 100% !important;
					height: 100% !important;
					position: absolute;
					top: 0;
					left: 0;
					z-index: 10;
				}
			</style>

			<script src="https://code.jquery.com/jquery-3.6.4.min.js" integrity="sha256-oP6HI9z1XaZNBrJURtCoUT5SUnxFr8s3BzRl+cbzUq8=" crossorigin="anonymous"></script>

			<script>
				$(document).ready(function () {

$('.video-player').each(function () {
var player = videojs(this);
// player.play();
});

});
			</script>
		</div>
	</section>
	<!-- End Commercials Section -->
{% endblock %}
