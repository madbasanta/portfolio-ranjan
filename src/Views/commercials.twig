{% extends "master.twig" %}

{% block content %}
<!-- ======= Commercials Section ======= -->
<section id="commercials" class="section-show py-5 bg-light">
    <div class="container">
        <div class="section-title text-center mb-5">
            <h2 class="display-4 fw-bold text-primary">Commercials</h2>
            <p class="lead text-muted">Social Media Content</p>
        </div>

        <!-- Video Grid -->
        <div class="row g-4">
            {% for item in items %}
            <div class="col-md-4 col-sm-6 mb-3">
                <div class="video-card position-relative rounded overflow-hidden" style="cursor:pointer;" 
                     data-src="{{item.video}}"
                     data-poster="{{item.poster}}">
                    <div class="video-content">
                        <img src="{{item.poster}}" 
                             alt="{{item.title}}" 
                             class="w-100" 
                             style="aspect-ratio: 16/9; object-fit: cover;">
                        
                    </div>
                    <video class="video-player d-none video-js vjs-big-play-centered" controls preload="none" height="100%">
                        <source src="" type="video/mp4" />
                        <p>Your browser does not support the video tag.</p>
                    </video>
                </div>
            </div>
            {% endfor %}
        </div>

        <style>
        .video-card {
            transition: transform 0.3s ease;
            height: 100%;
        }
        
        .video-content {
            height: 100%;
            width: 100%;
        }
        
        .video-player {
            width: 100% !important;
            height: 100% !important;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 10;
        }
        
        </style>

        <script>
        document.addEventListener('DOMContentLoaded', function() {
            const videoCards = document.querySelectorAll('.video-card');
            
            videoCards.forEach(card => {
                const videoPlayer = card.querySelector('.video-player');
                const videoSrc = card.getAttribute('data-src');
                const poster = card.getAttribute('data-poster');
                
                // Initialize video player
                videoPlayer.innerHTML = `
                    <source src="${videoSrc}" type="video/mp4" />
                    <p>Your browser does not support the video tag.</p>
                `;
                
                // Initialize Video.js player
                let player = videojs(videoPlayer, {
                    autoplay: false,
                    controls: true,
                    fluid: false,
                    responsive: true,
                    controlBar: {
                        playToggle: true,
                        volumePanel: true,
                        progressControl: true,
                        remainingTimeDisplay: true,
                        fullscreenToggle: true
                    },
                    techOrder: ['html5'],
                    playbackRates: [0.5, 1, 1.5, 2],
                    preload: 'metadata',
                    width: '100%',
                    height: '100%',
                    controls: true,
                    sources: [{
                        src: videoSrc,
                        type: 'video/mp4',
                        quality: 'low'
                    }],
                    html5: {
                        nativeControlsForTouch: true,
                        vhs: {
                            overrideNative: false
                        }
                    }
                });

                // Add click handler
                const handleVideoClick = function(e) {
                    // Prevent default behavior on iPhone
                    e.preventDefault();
                    e.stopPropagation();

                    // Toggle play/pause
                    if (videoPlayer.parentElement.classList.contains('d-none')) {
                        // For iPhone, we need to ensure the video is visible before playing
                        videoPlayer.parentElement.classList.remove('d-none');
                        
                        // Small delay to ensure visibility before playing
                        setTimeout(() => {
                            player.play();
                        }, 100);

                        videoCards.forEach(card => {
                            if (card !== this) {
                                let p = card.querySelector('.video-player>video');
                                videojs(p).pause();
                            }
                        });
                    }
                };

                // Add click/touch event listeners
                card.addEventListener('click', handleVideoClick);
                card.addEventListener('touchstart', handleVideoClick, { passive: false });

                // Add event listener for video end
                // player.on('ended', function() {
                //     videoPlayer.parentElement.classList.add('d-none');
                // });
            });
        });
        </script>
    </div>
</section>
<!-- End Commercials Section -->
{% endblock %}