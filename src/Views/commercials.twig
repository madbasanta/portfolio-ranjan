{% extends "master.twig" %}

{% block content %}
<!-- ======= events Section ======= -->
<section id="commercials" class="section-show">
    <div class="resume">
        <div class="container">

            <div class="section-title">
                <h2>Commercials</h2>
                <p>Social Media Content</p>
            </div>

            <div class="row">
                <!-- Left: Video Player -->
                <div class="col-md-9">
                    <video id="mainVideo" class="video-js" controls width="auto" height="600px" preload="none" poster="/assets/img/me.jpg"
                        data-setup='{}'>
                        <source src="/assets/Bishesh-BTS.mp4" type="video/mp4" />
                        Your browser does not support the video tag.
                    </video>
                </div>

                <!-- Right: Playlist -->
                <div class="col-md-3">
                    <div class="video-list d-flex flex-column gap-2">
                        {%for item in items%}
                        <div class="video-item mb-2 rounded shadow-sm cursor-pointer" data-src="{{item.video}}" style="width: 100%;"
                        {% if item.poster %}
                            data-poster="{{item.poster}}"
                            {% endif %} >
                            
                            <img src="{{item.poster}}" alt="Video 2" class="rounded w-100"
                                style="aspect-ratio: 16/9; object-fit: cover;">
                            
                        </div>
                        {%endfor%}
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<!-- End events Section -->
{% endblock %}