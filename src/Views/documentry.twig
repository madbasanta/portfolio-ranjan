<!-- ======= documentry Section ======= -->
<section id="documentry">
    {%for item in items%}
    <div class="resume">
        <div class="container">

            <div class="section-title">
                <h2>Documentary</h2>
                <p>{{item.title}}</p>
            </div>

            <div class="row">
                <div class="col-lg-6">
                    <iframe width="100%" height="315"
                        src="{{item.youtube}}" title="YouTube video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
                </div>
                <div class="col-lg-6">
                    <div class="resume-item pb-0">
                        {{item.description|raw}}
                    </div>
                </div>
            </div>

        </div>
    </div>
    {%endfor%}
    {%include 'footer.twig' %}
</section>
<!-- End documentry Section -->