{% extends "master.twig" %}

{% block content %}
<!-- ======= Home Section ======= -->
<section id="home" class="about section-show" style="padding-bottom: 0;">

  <!-- ======= About Me ======= -->
  <div class="about-me">

    <!-- video slider -->
    <div class="row">
      <div class="col-lg-12">
        <div id="homeVideo1">
          <video class="mt-3 mt-lg-0" width="100%" height="100%" autoplay muted loop style="aspect-ratio: 16/9;">
            <source src="/assets/teaser.mp4" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        </div>
      </div>
      <div class="col-lg-12">

        <div id="aboutMe" class=""
          style="position: relative; z-index: 2; background-color: white;">
          <!-- ======= About Me ======= -->
          <div class="about-me container">
            <div class="row">
              <div class="col-md-4 mb-3">
                <img src="/assets/img/home/1.jpeg" alt="lost" class="img-fluid mt-5">
              </div>
              <div class="col-md-4 mb-3">
                <img src="/assets/img/home/2.png" alt="firm festival winner" class="img-fluid mt-5">
              </div>
              <div class="col-md-4 mb-3">
                <img src="/assets/img/home/3.jpg" alt="coventry phoenix" class="img-fluid">
              </div>
              <div class="col-md-4 mb-3">
                <img src="/assets/img/home/4.jpg" alt="bts" class="img-fluid">
              </div>
              <div class="col-md-4 mb-3">
                <img src="/assets/img/home/5.jpg" alt="bts2" class="img-fluid">
              </div>
              <div class="col-md-4 mb-3">
                <img src="/assets/img/home/6.jpg" alt="creative artist" class="img-fluid">
              </div>
            </div>
          </div>
          <div class="about-me container">

            <div class="section-title">
              <!-- <h2>About</h2> -->
              <p>about me</p>
            </div>

            <div class="row">
              <div class="col-lg-5" data-aos="fade-right">
                <img src="/assets/img/profile.jpg?v=1.0" class="img-fluid" alt="">
              </div>
              <div class="col-lg-7 pt-4 pt-lg-0 content" data-aos="fade-left">
                <h3>Cinematographer/Post-production</h3>
                <p>
                  Success-driven, results-focused, camera operator/cinematographer and videographer with extensive knowledge in film and media production processes, proficient in camera operation, visual storytelling and lighting techniques, post-production processes, experience with frame.io, encompassing technical support, equipment maintenance and production management. Acting as a primary contact to support producer, director, crew members and clients with creative process, technical solutions and social media marketing campaigns.
                  <p>ACHIEVEMENTS: Cinematographer for the musical documentary "Lost" which was nominated and won “Best Documentary” award at the Coventry Phoenix Film Festival 2024</p>
                </p>
              </div>
            </div>

          </div><!-- End About Me -->

          {%include 'footer.twig' %}

          <br><br>

        </div>

      </div>
    </div>

  </div><!-- End About Me -->

</section><!-- End Home Section -->
